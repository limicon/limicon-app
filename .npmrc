# Skip package versions published in the last 3 days; compromised releases are usually pulled
# within that time. Override for one urgent install with `--min-release-age=0`.
min-release-age=3

# Fail the install when a dependency's install scripts aren't listed in package.json
# `allowScripts`. Record a decision with `npm install-scripts approve|deny <pkg>`.
strict-allow-scripts=true
