/**
 * Cloudflare Worker configuration.
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "limicon-app",
	// The Limicon Cloudflare account, so deploys can't land in anyone's personal account.
	"account_id": "6db426201c07f3bf300a732d251ebbc8",
	"compatibility_date": "2026-11-10",
	// postgres.js needs Node's net, tls and crypto APIs.
	"compatibility_flags": ["nodejs_compat"],
	"main": "./workers/app.ts",
	// Run next to the Supabase database in North Virginia, so each page pays one long round trip
	// to the visitor instead of one per query. Static files are still served from the nearest
	// data centre.
	"placement": { "mode": "targeted", "region": "aws:us-east-1" },
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			// `limicon-db`, which reaches Supabase through its session pooler: the direct
			// connection is IPv6-only, and Hyperdrive can't reach it.
			"id": "25f8578782384c258d7614e1a7d3ffdf",
			// The local Supabase database from `npm run db:start`.
			"localConnectionString": "postgresql://postgres:postgres@127.0.0.1:54372/postgres"
		}
	],
	// The hosted Supabase project, for sign-in. Both values are public. `.dev.vars` overrides
	// them locally to point at the local Supabase.
	"vars": {
		"SUPABASE_URL": "https://kgvkzvocadtlbntpmutq.supabase.co",
		"SUPABASE_PUBLISHABLE_KEY": "sb_publishable_E7ge_wNZO9PsY12pjYEl9Q_YMUN4bdA",
		"GOOGLE_SIGN_IN_ENABLED": "true"
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true
}
