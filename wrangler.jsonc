/**
 * Cloudflare Worker configuration.
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "limicon-app",
	// The Limicon Cloudflare account, so deploys can't land in anyone's personal account.
	"account_id": "6db426201c07f3bf300a732d251ebbc8",
	"compatibility_date": "2026-11-10",
	// postgres.js needs Node's net, tls and crypto APIs.
	"compatibility_flags": ["nodejs_compat"],
	"main": "./workers/app.ts",
	// Run next to the Supabase database in North Virginia, so each page pays one long round trip
	// to the visitor instead of one per query. Static files are still served from the nearest
	// data centre.
	"placement": { "mode": "targeted", "region": "aws:us-east-1" },
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			// `limicon-db`, which reaches Supabase through its session pooler: the direct
			// connection is IPv6-only, and Hyperdrive can't reach it.
			"id": "25f8578782384c258d7614e1a7d3ffdf",
			// The local Supabase database from `npm run db:start`.
			"localConnectionString": "postgresql://postgres:postgres@127.0.0.1:54372/postgres"
		}
	],
	// Images and files admins upload, such as the event image and attachments in rich text. Served
	// by the app at /media/<key>. Locally, Wrangler keeps the bucket on disk under .wrangler.
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "limicon-media"
		}
	],
	// The hosted Supabase project, for sign-in. Both values are public. `.dev.vars` overrides
	// them locally to point at the local Supabase.
	"vars": {
		"SUPABASE_URL": "https://kgvkzvocadtlbntpmutq.supabase.co",
		"SUPABASE_PUBLISHABLE_KEY": "sb_publishable_E7ge_wNZO9PsY12pjYEl9Q_YMUN4bdA",
		"GOOGLE_SIGN_IN_ENABLED": "true",
		// "on" lets search engines list the site. Off while it's a test site shared by link;
		// switch it on when limicon.org points here.
		"SEARCH_INDEXING": "off",
		// The app's address, for links to session pages in Google Calendar events.
		"APP_URL": "https://limicon-app.limicon.workers.dev",
		// team@limicon.org's Google calendars, from `npm run calendar:connect`
		// (docs/feature-calendaring.md → Google Calendar): the public Limicon Schedule calendar
		// members subscribe to, and the one holding members' RSVP invites. The sync also needs the
		// Worker secrets GOOGLE_CALENDAR_CLIENT_ID, GOOGLE_CALENDAR_CLIENT_SECRET and
		// GOOGLE_CALENDAR_REFRESH_TOKEN, and does nothing until all are set.
		"GOOGLE_CALENDAR_ID": "c_9b02ec3ea874091606686ec19f7d43b841cbc201e75fdf3e46c1925809c1c759@group.calendar.google.com",
		"GOOGLE_INVITES_CALENDAR_ID": "c_5b25430e0d5dd5a6e8ef1b4f0c400e75572afb582fd43b6750df78a6491a471d@group.calendar.google.com"
	},
	// Retries Google Calendar syncs that didn't finish after a form post.
	"triggers": { "crons": ["* * * * *"] },
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true
}
